    "A pair with a chart for a day, week or month": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زوج عملات مع مخطط ليوم أو أسبوع أو شهر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Paar mit Diagramm für Tag, Woche oder Monat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pair with a chart for a day, week or month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par con gráfico de un día, una semana o un mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une paire avec un graphique sur un jour, une semaine ou un mois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una coppia con grafico di un giorno, una settimana o un mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日・1週間・1か月のチャート付き通貨ペア"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루·일주일·한 달 차트가 있는 통화 쌍"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Para walut z wykresem z dnia, tygodnia lub miesiąca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um par com gráfico de um dia, semana ou mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пара валют и график за день, неделю или месяц"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün, hafta veya ay için grafikli kur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
