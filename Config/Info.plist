<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Системный экран запуска — только фон (цвет фона списка): иконку можно сменить в настройках,
	     а картинка экрана запуска одна на все иконки. Выбранную иконку показывает SplashView.
	     Остальные ключи Info.plist генерирует Xcode. -->
	<!-- Статус-бар скрыт на экране запуска и во время сплэша, появляется вместе со списком. -->
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>SplashBackground</string>
	</dict>
</dict>
</plist>
